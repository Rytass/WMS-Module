{
  "name": "graphql",
  "projectType": "library",
  "sourceRoot": "libs/graphql/src",
  "prefix": "wms-module",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "{projectRoot}/index.cjs.js",
        "{projectRoot}/index.js",
        "{projectRoot}/index.d.ts",
        "{projectRoot}/lib"
      ],
      "options": {
        "cwd": "libs/graphql",
        "command": "rollup -c rollup.config.mjs"
      }
    },
    "clean": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "libs/graphql",
        "commands": [
          "rm -rf index.cjs.js index.js index.d.ts lib"
        ],
        "parallel": false
      }
    },
    "pkg-quality": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "build"
      ],
      "options": {
        "command": "npx -y publint run libs/graphql --pack false",
        "parallel": false
      }
    },
    "pkg-quality-attw": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "build"
      ],
      "options": {
        "parallel": false,
        "commands": [
          "npm pack --pack-destination ./libs/graphql ./libs/graphql",
          "npx -y @arethetypeswrong/cli ./libs/graphql/*.tgz",
          "rm -f ./libs/graphql/*.tgz"
        ]
      }
    },
    "prepublish-check": {
      "executor": "nx:noop",
      "dependsOn": [
        "typecheck",
        "lint",
        "build",
        "pkg-quality"
      ]
    }
  },
  "tags": []
}
