{
  "name": "graphql",
  "projectType": "library",
  "sourceRoot": "libs/graphql/src",
  "prefix": "wms-module",
  "targets": {
    "typecheck": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "^build"
      ],
      "options": {
        "cwd": "libs/graphql",
        "command": "tsc -p tsconfig.typecheck.json"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "{projectRoot}/index.cjs.js",
        "{projectRoot}/index.mjs",
        "{projectRoot}/index.d.ts",
        "{projectRoot}/index.d.mts",
        "{projectRoot}/lib",
        "{projectRoot}/adapters"
      ],
      "options": {
        "cwd": "libs/graphql",
        "parallel": false,
        "commands": [
          "rollup -c rollup.config.mjs",
          "node ../../tools/emit-esm-type-shims.mjs . index adapters/member-base adapters/event-emitter"
        ]
      }
    },
    "clean": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "libs/graphql",
        "commands": [
          "rm -rf index.cjs.js index.js index.mjs index.d.ts index.d.mts lib adapters tsconfig.tsbuildinfo"
        ],
        "parallel": false
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "parallel": false,
        "commands": [
          "tsc -p libs/graphql/tsconfig.spec.json",
          "jest -c libs/graphql/jest.config.mjs"
        ]
      }
    },
    "pkg-quality": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "build"
      ],
      "options": {
        "command": "node tools/pkg-gate.mjs libs/graphql",
        "parallel": false
      }
    },
    "prepublish-check": {
      "executor": "nx:noop",
      "dependsOn": [
        "typecheck",
        "lint",
        "build",
        "pkg-quality"
      ]
    }
  },
  "tags": []
}
