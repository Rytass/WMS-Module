{
  "name": "@rytass/wms-module-graphql",
  "version": "0.1.0",
  "description": "Rytass WMS Module — GraphQL schema, resolvers and DTOs for warehouse management",
  "keywords": [
    "rytass",
    "wms",
    "warehouse",
    "nestjs",
    "graphql"
  ],
  "author": "Chia Yu Pai <fantasyatelier@gmail.com>",
  "homepage": "https://github.com/Rytass/WMS-Module#readme",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Rytass/WMS-Module.git"
  },
  "bugs": {
    "url": "https://github.com/Rytass/WMS-Module/issues"
  },
  "main": "./index.cjs.js",
  "module": "./index.js",
  "typings": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "require": "./index.cjs.js",
      "import": "./index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "**/*.js",
    "**/*.d.ts",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "dataloader": "^2.2.3",
    "lru-cache": "^10.0.0"
  },
  "peerDependencies": {
    "@as-integrations/express5": "^1.0.0",
    "@nestjs/apollo": "^13.0.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/graphql": "^13.0.0",
    "@rytass/wms-module-core": "^0.1.0",
    "graphql": "^16.0.0",
    "reflect-metadata": "^0.1.13 || ^0.2.0",
    "rxjs": "^7.8.0"
  }
}
