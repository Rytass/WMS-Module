{
  "name": "@rytass/wms-module-graphql",
  "version": "0.10.0",
  "description": "Rytass WMS Module — GraphQL schema, resolvers and DTOs for warehouse management",
  "keywords": [
    "rytass",
    "wms",
    "warehouse",
    "nestjs",
    "graphql"
  ],
  "author": "Chia Yu Pai <fantasyatelier@gmail.com>",
  "homepage": "https://github.com/Rytass/WMS-Module#readme",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Rytass/WMS-Module.git"
  },
  "bugs": {
    "url": "https://github.com/Rytass/WMS-Module/issues"
  },
  "main": "./index.cjs.js",
  "module": "./index.js",
  "typings": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "require": "./index.cjs.js",
      "import": "./index.js"
    },
    "./adapters/member-base": {
      "types": "./adapters/member-base.d.ts",
      "require": "./adapters/member-base.cjs.js",
      "import": "./adapters/member-base.js"
    },
    "./adapters/event-emitter": {
      "types": "./adapters/event-emitter.d.ts",
      "require": "./adapters/event-emitter.cjs.js",
      "import": "./adapters/event-emitter.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "**/*.js",
    "**/*.d.ts",
    "README.md",
    "LICENSE",
    "docs"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "dataloader": "^2.2.3",
    "lodash": "^4.17.0",
    "lru-cache": "^10.0.0 || ^11.0.0"
  },
  "peerDependencies": {
    "@as-integrations/express5": "^1.0.0",
    "@nestjs/apollo": "^13.0.0",
    "@nestjs/common": "^10.0.0 || ^11.0.0",
    "@nestjs/core": "^10.0.0 || ^11.0.0",
    "@nestjs/graphql": "^13.0.0",
    "@rytass/wms-base-nestjs-module": "^0.4.0",
    "@rytass/wms-module-core": "^0.7.0",
    "graphql": "^16.0.0",
    "reflect-metadata": "^0.1.13 || ^0.2.0",
    "rxjs": "^7.0.0",
    "typeorm": "^0.3.0",
    "@nestjs/event-emitter": "^2.0.0 || ^3.0.0"
  },
  "peerDependenciesMeta": {
    "@nestjs/event-emitter": {
      "optional": true
    }
  }
}
