{
  "name": "core",
  "projectType": "library",
  "sourceRoot": "libs/core/src",
  "prefix": "wms-module",
  "targets": {
    "typecheck": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "^build"
      ],
      "options": {
        "cwd": "libs/core",
        "command": "tsc -p tsconfig.typecheck.json"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "outputs": [
        "{projectRoot}/index.cjs.js",
        "{projectRoot}/index.d.ts",
        "{projectRoot}/lib",
        "{projectRoot}/constants",
        "{projectRoot}/models",
        "{projectRoot}/services",
        "{projectRoot}/typings"
      ],
      "options": {
        "cwd": "libs/core",
        "parallel": false,
        "commands": [
          "rollup -c rollup.config.mjs",
          "tsc -p tsconfig.lib.json --emitDeclarationOnly"
        ]
      }
    },
    "clean": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "libs/core",
        "commands": [
          "rm -rf index.cjs.js index.js index.mjs index.d.ts index.d.mts lib constants models services typings tsconfig.tsbuildinfo"
        ],
        "parallel": false
      }
    },
    "pkg-quality": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "build"
      ],
      "options": {
        "command": "node tools/pkg-gate.mjs libs/core",
        "parallel": false
      }
    },
    "prepublish-check": {
      "executor": "nx:noop",
      "dependsOn": [
        "typecheck",
        "lint",
        "build",
        "pkg-quality"
      ]
    }
  },
  "tags": []
}
