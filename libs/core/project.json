{
  "name": "core",
  "projectType": "library",
  "sourceRoot": "libs/core/src",
  "prefix": "wms-module",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": [
        "{projectRoot}/index.cjs.js",
        "{projectRoot}/index.js",
        "{projectRoot}/index.d.ts",
        "{projectRoot}/lib",
        "{projectRoot}/constants",
        "{projectRoot}/models",
        "{projectRoot}/services",
        "{projectRoot}/typings"
      ],
      "options": {
        "cwd": "libs/core",
        "command": "rollup -c rollup.config.mjs"
      }
    },
    "clean": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "libs/core",
        "commands": [
          "rm -rf index.cjs.js index.js index.d.ts lib constants models services typings"
        ],
        "parallel": false
      }
    },
    "pkg-quality": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "command": "yarn dlx publint run libs/core --pack false",
        "parallel": false
      }
    },
    "pkg-quality-attw": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "parallel": false,
        "commands": [
          "npm pack --pack-destination ./libs/core ./libs/core",
          "yarn dlx @arethetypeswrong/cli ./libs/core/*.tgz",
          "rm -f ./libs/core/*.tgz"
        ]
      }
    },
    "prepublish-check": {
      "executor": "nx:noop",
      "dependsOn": ["typecheck", "lint", "build", "pkg-quality"]
    }
  },
  "tags": []
}
