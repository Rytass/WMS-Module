{
  "name": "@rytass/wms-module-core",
  "version": "0.9.1",
  "description": "Rytass WMS Module — NestJS services and TypeORM entities for warehouse management",
  "keywords": [
    "rytass",
    "wms",
    "warehouse",
    "nestjs",
    "typeorm"
  ],
  "author": "Chia Yu Pai <fantasyatelier@gmail.com>",
  "homepage": "https://github.com/Rytass/WMS-Module#readme",
  "license": "MIT",
  "type": "commonjs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Rytass/WMS-Module.git"
  },
  "bugs": {
    "url": "https://github.com/Rytass/WMS-Module/issues"
  },
  "main": "./index.cjs.js",
  "module": "./index.mjs",
  "typings": "./index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./index.d.mts",
        "default": "./index.mjs"
      },
      "require": {
        "types": "./index.d.ts",
        "default": "./index.cjs.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "**/*.js",
    "**/*.mjs",
    "**/*.d.ts",
    "**/*.d.mts",
    "README.md",
    "LICENSE",
    "docs",
    "!src",
    "!*.config.mjs",
    "!scripts"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "luxon": "^3.0.0",
    "tslib": "^2.6.0"
  },
  "peerDependencies": {
    "@nestjs/common": "^10.0.0 || ^11.0.0",
    "@nestjs/typeorm": "^10.0.0 || ^11.0.0",
    "@rytass/wms-base-nestjs-module": "^0.4.0",
    "reflect-metadata": "^0.1.13 || ^0.2.0",
    "typeorm": "^0.3.0 || ^1.0.0"
  }
}
