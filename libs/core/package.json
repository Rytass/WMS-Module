{
  "name": "@rytass/wms-module-core",
  "version": "0.1.0",
  "description": "Rytass WMS Module — NestJS services and TypeORM entities for warehouse management",
  "keywords": [
    "rytass",
    "wms",
    "warehouse",
    "nestjs",
    "typeorm"
  ],
  "author": "Chia Yu Pai <fantasyatelier@gmail.com>",
  "homepage": "https://github.com/Rytass/WMS-Module#readme",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Rytass/WMS-Module.git"
  },
  "bugs": {
    "url": "https://github.com/Rytass/WMS-Module/issues"
  },
  "main": "./index.cjs.js",
  "module": "./index.js",
  "typings": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "require": "./index.cjs.js",
      "import": "./index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "**/*.js",
    "**/*.d.ts",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@rytass/wms-base-nestjs-module": "0.1.11"
  },
  "peerDependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/typeorm": "^11.0.0",
    "reflect-metadata": "^0.1.13 || ^0.2.0",
    "rxjs": "^7.8.0",
    "typeorm": "^0.3.0"
  }
}
